# Copy to .env for local development: cp .env.example .env
# Every variable is validated at startup; the API refuses to start if one is invalid.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# `npm run db:up` starts MongoDB on this address.
MONGODB_URI=mongodb://localhost:27017/nest-react-auth

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Local development runs over plain HTTP. Keep `true` (the default) anywhere behind TLS.
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (0 when the API is hit directly).
TRUST_PROXY=0

# Comma-separated origins for cross-origin clients. Leave empty when the web app is
# served from the same origin (the Vite dev proxy and the nginx image both do that).
CORS_ORIGINS=

SWAGGER_ENABLED=true
